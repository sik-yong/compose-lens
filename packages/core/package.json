{
  "name": "@compose-lens/core",
  "version": "0.0.0",
  "description": "Docker Compose parser, diagnostics, and graph conversion for Compose Lens. No UI or DOM dependencies.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:node": "node test/node-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist"
  ]
}
